# Postgres (Neon). App runtime uses the restricted role; migrations use the owner role.
DATABASE_URL=postgres://app_user:password@HOST/neondb?sslmode=require
DATABASE_URL_OWNER=postgres://owner:password@HOST/neondb?sslmode=require
# Name of the restricted role in DATABASE_URL; rls.sql grants it access (default: crm_app).
APP_DB_ROLE=crm_app

# Auth (Phase 1)
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe (Phase 1). Use a RESTRICTED key with only 'Checkout Sessions: Write', from a test-mode
# account. The webhook secret (whsec_...) is separate and comes from the webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Phase 1). Without RESEND_API_KEY, non-production keeps mail in memory (never logs it);
# set EMAIL_DEV_DIR=.dev-mail to also write each message to a file for manual testing.
RESEND_API_KEY=
EMAIL_FROM=CRM <licenses@your-verified-domain>
EMAIL_DEV_DIR=

# Cloudflare R2 attachments (Phase 2+)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

APP_URL=http://localhost:3000

# Platform admin console (/admin). ADMIN_TOTP_KEY encrypts admins' authenticator secrets at rest:
# 32 random bytes, base64 (generate with `openssl rand -base64 32`). Required to use /admin.
ADMIN_TOTP_KEY=
# Optional: only these IPs/CIDR ranges can reach /admin (others get a 404). Comma-separated.
ADMIN_IP_ALLOWLIST=

# Shown on the Help guide as "Email ... for help". Leave empty to tell people to ask their administrator.
SUPPORT_EMAIL=
