# Postgres (Neon). App runtime uses the restricted role; migrations use the owner role.
DATABASE_URL=postgres://app_user:password@HOST/neondb?sslmode=require
DATABASE_URL_OWNER=postgres://owner:password@HOST/neondb?sslmode=require
# Name of the restricted role in DATABASE_URL; rls.sql grants it access (default: crm_app).
APP_DB_ROLE=crm_app

# Auth (Phase 1)
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe (Phase 1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Phase 1)
RESEND_API_KEY=

# Cloudflare R2 attachments (Phase 2+)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

APP_URL=http://localhost:3000
