# Postgres (Neon). App runtime uses the restricted role; migrations use the owner role.
DATABASE_URL=postgres://app_user:password@HOST/neondb?sslmode=require
DATABASE_URL_OWNER=postgres://owner:password@HOST/neondb?sslmode=require
# Name of the restricted role in DATABASE_URL; rls.sql grants it access (default: crm_app).
APP_DB_ROLE=crm_app

# Auth (Phase 1)
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe. Use a RESTRICTED key from a separate TEST-mode account, never the live account.
# Permissions: Checkout Sessions (write), Subscriptions (write), Customers (write),
# Invoices (read), Charges (read), SetupIntents (write), Payment Methods (write).
# A live key (sk_live_/rk_live_) is refused unless STRIPE_ALLOW_LIVE=true is set on purpose.
STRIPE_SECRET_KEY=
# The publishable key (pk_...) is safe to show in the browser; it draws the on-site payment form.
STRIPE_PUBLISHABLE_KEY=
# The webhook secret (whsec_...) comes from the webhook endpoint, not from the API keys.
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=

# Email (Phase 1). Without RESEND_API_KEY, non-production keeps mail in memory (never logs it);
# set EMAIL_DEV_DIR=.dev-mail to also write each message to a file for manual testing.
RESEND_API_KEY=
EMAIL_FROM=CRM <licenses@your-verified-domain>
EMAIL_DEV_DIR=

# Cloudflare R2 attachments (Phase 2+)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

APP_URL=http://localhost:3000

# Platform admin console (/admin). ADMIN_TOTP_KEY encrypts admins' authenticator secrets at rest:
# 32 random bytes, base64 (generate with `openssl rand -base64 32`). Required to use /admin.
ADMIN_TOTP_KEY=
# Optional: only these IPs/CIDR ranges can reach /admin (others get a 404). Comma-separated.
ADMIN_IP_ALLOWLIST=

# Shown on the Help guide as "Email ... for help", and used for the "Get in touch" and "Get <plan>" buttons on
# the public home page (the plans have no checkout: buyers email you). Leave empty and those buttons are hidden or
# jump to the page's contact section; the Help guide then tells people to ask their administrator.
SUPPORT_EMAIL=
